"controller_mappings"
{
    "version" "3"
    "title" "Keyboard (WASD) & Mouse"
    "controller_type" "controller_xboxone"
    "aurora_bindings"
    {
        "Left stick" "unassigned"
        "LS ↑" "key_press W"
        "LS ←" "key_press A"
        "LS ↓" "key_press S"
        "LS →" "key_press D"
        "Right stick" "mouse_move"
        "Gyroscope" "mouse_move"
        "A" "key_press SPACE"
        "B" "key_press ESC"
        "X" "key_press R"
        "Y" "key_press E"
        "LB" "mouse_button WHEEL_UP"
        "RB" "mouse_button WHEEL_DOWN"
        "LT" "mouse_button RIGHT"
        "RT" "mouse_button LEFT"
        "L3" "key_press SHIFT"
        "R3" "key_press CTRL"
        "Start" "key_press ESC"
        "Back" "key_press TAB"
        "D-pad ↑" "key_press UP"
        "D-pad ↓" "key_press DOWN"
        "D-pad ←" "key_press LEFT"
        "D-pad →" "key_press RIGHT"
    }
}
